[
 {
  "id": "var-scopes-tracked",
  "feature": "variables",
  "file": "postman-runtime",
  "claim": "Scripts can mutate the globals, environment and collectionVariables scopes; runtime tracks those three for write-back.",
  "pattern": "trackContext:\\[\"globals\",\"environment\",\"collectionVariables\"\\]"
 },
 {
  "id": "var-scope-list",
  "feature": "variables",
  "file": "postman-runtime",
  "claim": "The execution context carries _variables (local), environment, globals, collectionVariables, cookies, data, request, response.",
  "pattern": "\\[\"_variables\",\"environment\",\"globals\",\"collectionVariables\",\"cookies\",\"data\",\"request\",\"response\"\\]"
 },
 {
  "id": "var-resolution-order",
  "feature": "variables",
  "file": "postman-runtime",
  "claim": "Request resolution passes scopes in order _variables, data, environment, collectionVariables, globals (narrowest wins).",
  "pattern": "\\[\"_variables\",\"data\",\"environment\",\"collectionVariables\",\"globals\"[^\\]]*\\]"
 },
 {
  "id": "test-tracks-tests",
  "feature": "sandbox",
  "file": "postman-runtime",
  "claim": "Test scripts additionally track the legacy tests object.",
  "pattern": "trackContext:\\[\"tests\",\"globals\",\"environment\",\"collectionVariables\"\\]"
 },
 {
  "id": "stop-on-script-error",
  "feature": "runner",
  "file": "postman-runtime",
  "claim": "Runner options stopOnScriptError, stopOnFailure and abortOnFailure exist.",
  "pattern": "stopOnScriptError:\\w+,stopOnFailure:\\w+"
 },
 {
  "id": "requester-gzip-brotli",
  "feature": "engine",
  "file": "postman-runtime",
  "claim": "Requester always enables gzip and brotli decoding and optional timings.",
  "pattern": "\\w\\.gzip=!0,\\w\\.brotli=!0,\\w\\.time=\\w\\.timings"
 },
 {
  "id": "timeout-min",
  "feature": "engine",
  "file": "postman-runtime",
  "claim": "Effective request timeout is the minimum of timeout.request and timeout.global.",
  "pattern": "min\\(\\[\\w\\.get\\(\\w,\"timeout\\.request\"\\),\\w\\.get\\(\\w,\"timeout\\.global\"\\)\\]\\)"
 },
 {
  "id": "max-redirects",
  "feature": "engine",
  "file": "postman-runtime",
  "claim": "maxRedirects is a protocolProfileBehavior option.",
  "pattern": "maxRedirects:\"maxRedirects\""
 },
 {
  "id": "follow-redirects-opt",
  "feature": "engine",
  "file": "postman-runtime",
  "claim": "Redirects are followed by default (requester.followRedirects defaults to true).",
  "pattern": "followRedirects:\\w\\.get\\(\\w,\"requester\\.followRedirects\",!0\\)",
  "max": 1
 },
 {
  "id": "disable-body-pruning",
  "feature": "engine",
  "file": "postman-runtime",
  "claim": "disableBodyPruning controls whether GET/HEAD bodies are dropped.",
  "pattern": ".{0,80}disableBodyPruning.{0,80}"
 },
 {
  "id": "auth-types",
  "feature": "auth",
  "file": "postman-runtime",
  "claim": "Supported auth handler names.",
  "pattern": "new Set\\(\\[\"noauth\",\"awsv4\",\"basic\",\"bearer\"[^\\]]*\\]\\)",
  "max": 1
 },
 {
  "id": "aws-service",
  "feature": "auth",
  "file": "postman-runtime",
  "claim": "AWS v4 auth uses the aws4 signer with service and region.",
  "pattern": ".{0,60}awsv4.{0,120}"
 },
 {
  "id": "digest-qop",
  "feature": "auth",
  "file": "postman-runtime",
  "claim": "Digest auth supports qop auth and auth-int.",
  "pattern": ".{0,60}auth-int.{0,60}"
 },
 {
  "id": "oauth2-header-prefix",
  "feature": "auth",
  "file": "postman-runtime",
  "claim": "OAuth2 adds the token with a configurable headerPrefix, default Bearer.",
  "pattern": ".{0,80}headerPrefix.{0,80}"
 },
 {
  "id": "apikey-in",
  "feature": "auth",
  "file": "postman-runtime",
  "claim": "API key auth rejects an empty key.",
  "pattern": ".{0,120}empty key in \\\\?\"API Key\\\\?\" auth.{0,40}",
  "max": 1
 },
 {
  "id": "dyn-guid",
  "feature": "dynamic-variables",
  "file": "postman-collection",
  "claim": "$guid dynamic variable is generated by the collection SDK.",
  "pattern": "\\$guid.{0,120}"
 },
 {
  "id": "dyn-timestamp",
  "feature": "dynamic-variables",
  "file": "postman-collection",
  "claim": "$timestamp is Unix seconds.",
  "pattern": "\\$timestamp.{0,160}"
 },
 {
  "id": "dyn-randomint",
  "feature": "dynamic-variables",
  "file": "postman-collection",
  "claim": "$randomInt is an integer in 0..1000.",
  "pattern": "\\$randomInt.{0,160}"
 },
 {
  "id": "var-syntax",
  "feature": "variables",
  "file": "postman-collection",
  "claim": "Variable reference syntax is {{name}} matched by a regex over double curly braces.",
  "pattern": "REGEX_EXTRACT_VARS:/\\{\\{\\(\\[\\^\\{\\}\\]\\*\\?\\)\\}\\}/g",
  "max": 1
 },
 {
  "id": "var-max-depth",
  "feature": "variables",
  "file": "postman-collection",
  "claim": "Nested variable substitution is bounded by a fixed recursion depth.",
  "pattern": "VARS_SUBREPLACE_LIMIT:\\d+",
  "max": 1
 },
 {
  "id": "cookie-jar",
  "feature": "cookies",
  "file": "postman-runtime",
  "claim": "Runtime keeps a cookie jar and exposes cookies to scripts.",
  "pattern": ".{0,60}cookieJar.{0,60}"
 },
 {
  "id": "ipc-channels",
  "feature": "desktop",
  "file": "main.js",
  "claim": "Main process IPC handler channel names (identifiers only).",
  "pattern": "ipcMain\\.(?:handle|on)\\(\"[^\"]+\"",
  "max": 10
 }
]