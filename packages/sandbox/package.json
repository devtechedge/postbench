{
  "name": "@postbench/sandbox",
  "version": "0.1.0",
  "description": "pm.* script sandbox compatible with Postman pre-request and test scripts",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": "./dist/index.js", "./pm": "./dist/pm.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@postbench/core": "workspace:*",
    "chai": "^4.5.0",
    "crypto-js": "^4.2.0",
    "lodash": "^4.17.21"
  },
  "devDependencies": {
    "@types/chai": "^4.3.20",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash": "^4.17.13",
    "postman-sandbox": "^6.0.0",
    "postman-collection": "^5.0.0"
  }
}
